# ==========================================
# APPLICATION PORTS
# ==========================================

USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
PAYMENT_SERVICE_PORT=3004
INVENTORY_SERVICE_PORT=3005
REVIEW_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007


# ==========================================
# USER SERVICE - MONGODB
# ==========================================

USER_MONGODB_URI=mongodb://user-mongodb:27017/usersdb


# ==========================================
# PRODUCT SERVICE - POSTGRESQL
# ==========================================

PRODUCT_DATABASE_URL=postgresql://postgres:postgres@product-postgres:5432/productsdb

PRODUCT_POSTGRES_DB=productsdb
PRODUCT_POSTGRES_USER=postgres
PRODUCT_POSTGRES_PASSWORD=postgres


# ==========================================
# ORDER SERVICE - MYSQL
# ==========================================

ORDER_MYSQL_DATABASE=ordersdb
ORDER_MYSQL_USER=orders
ORDER_MYSQL_PASSWORD=orders123
ORDER_MYSQL_ROOT_PASSWORD=root123

ORDER_DATABASE_URL=jdbc:mysql://order-mysql:3306/ordersdb


# ==========================================
# PAYMENT SERVICE - POSTGRESQL
# ==========================================

PAYMENT_POSTGRES_DB=paymentsdb
PAYMENT_POSTGRES_USER=postgres
PAYMENT_POSTGRES_PASSWORD=postgres

PAYMENT_POSTGRES_CONNECTION=Host=payment-postgres;Port=5432;Database=paymentsdb;Username=postgres;Password=postgres


# ==========================================
# INVENTORY SERVICE - MONGODB
# ==========================================

INVENTORY_MONGODB_URI=mongodb://inventory-mongodb:27017/inventorydb


# ==========================================
# REVIEW SERVICE - MYSQL
# ==========================================

REVIEW_MYSQL_DATABASE=reviewsdb
REVIEW_MYSQL_USER=reviews
REVIEW_MYSQL_PASSWORD=reviews123
REVIEW_MYSQL_ROOT_PASSWORD=root123


# ==========================================
# NOTIFICATION SERVICE - REDIS
# ==========================================

REDIS_URL=redis://notification-redis:6379